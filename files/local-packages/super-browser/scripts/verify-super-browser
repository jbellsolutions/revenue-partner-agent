#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT_DIR}"

PYTHON_BIN="${PYTHON_BIN:-python3}"
export PYTHONPATH="${ROOT_DIR}/src:${PYTHONPATH:-}"
export SUPER_BROWSER_REPO_ROOT="${ROOT_DIR}"

VERIFY_TMP_DIR="${SUPER_BROWSER_VERIFY_TMP_DIR:-$(mktemp -d "${TMPDIR:-/tmp}/super-browser-verify.XXXXXX")}"
VERIFY_OWNS_TMP=1
if [[ -n "${SUPER_BROWSER_VERIFY_TMP_DIR:-}" ]]; then
  mkdir -p "${VERIFY_TMP_DIR}"
  VERIFY_OWNS_TMP=0
fi

cleanup() {
  if [[ "${VERIFY_OWNS_TMP}" == "1" ]]; then
    rm -rf "${VERIFY_TMP_DIR}"
  fi
}
trap cleanup EXIT

export SUPER_BROWSER_STATE_DIR="${SUPER_BROWSER_VERIFY_STATE_DIR:-${VERIFY_TMP_DIR}/state}"
export PYTHONPYCACHEPREFIX="${SUPER_BROWSER_VERIFY_PYCACHE_DIR:-${VERIFY_TMP_DIR}/pycache}"
mkdir -p "${SUPER_BROWSER_STATE_DIR}" "${PYTHONPYCACHEPREFIX}"

echo "== shipped package import and inventory =="
"${PYTHON_BIN}" - <<'PY'
from pathlib import Path
from super_browser.bundle import RESOURCE_URIS, build_bundle_manifest
from super_browser.mcp_server import RESOURCE_FILES, list_resources
from super_browser.providers import PROVIDERS, SUPPORTED_LIVE_WORKFLOW_CLASSES, provider_readiness
from super_browser.router import _specialist_review, build_plan, infer_task

root = Path.cwd()
manifest = build_bundle_manifest(root)
assert manifest["status"] == "ok" and not manifest["missing_required_paths"], manifest
assert len(PROVIDERS) == 8, PROVIDERS
assert set(RESOURCE_URIS) == set(RESOURCE_FILES), (RESOURCE_URIS, RESOURCE_FILES)
assert set(manifest["resources"]) == {item["uri"] for item in list_resources()}
blocked = {"airtop", "browser-use", "browserbase", "hyperbrowser", "orgo", "steel"}
assert all(not SUPPORTED_LIVE_WORKFLOW_CLASSES.get(name) for name in blocked)
readiness = {item["name"]: item for item in provider_readiness()}
assert all(not readiness[name]["configured"] and readiness[name]["configuration_status"] == "not_applicable_planning_only" for name in blocked), readiness
task = infer_task("compare browser provider capabilities for a public read")
reviews = [_specialist_review(name, task, [name], name) for name in blocked]
assert all(item["recommendation"] == "comparison only — non-executable" for item in reviews), reviews
blocked_plan = build_plan(infer_task("launch the production ad campaign now"))
assert not (set(blocked_plan.council_report["execution_sequence"]) & blocked), blocked_plan.to_dict()
print("shipped_inventory_ok", len(PROVIDERS), len(manifest["resources"]))
PY

echo "== compile check =="
"${PYTHON_BIN}" -m compileall -q src

echo "== doctor =="
./scripts/super-browser doctor

echo "== bundle manifest =="
./scripts/super-browser bundle-manifest

echo "== env checklist =="
./scripts/super-browser env-checklist

echo "== fail-closed policy smoke =="
"${PYTHON_BIN}" - <<'PY'
from super_browser.router import build_plan, infer_task

task = infer_task("launch the production ad campaign now")
plan = build_plan(task)
assert plan.approval_required
assert plan.council_report["approval_gate"]["required"]
assert not plan.council_report["execution_sequence"]
print("approval_stop_ok non_executable")
PY

echo "== local Playwright readiness =="
if "${PYTHON_BIN}" -c "import playwright" >/dev/null 2>&1; then
  ./scripts/super-browser live-test --provider local
elif [[ "${SUPER_BROWSER_VERIFY_REQUIRE_LOCAL_LIVE:-0}" == "1" ]]; then
  echo "Playwright runtime is required but unavailable" >&2
  exit 1
else
  echo "skipped: Playwright is not installed in this verifier environment; the baked build separately installs Chromium and proves a real launch"
fi

echo "== production readiness gate =="
set +e
./scripts/super-browser production-readiness
PRODUCTION_READINESS_STATUS=$?
set -e
if [[ "${PRODUCTION_READINESS_STATUS}" != "0" && "${PRODUCTION_READINESS_STATUS}" != "1" ]]; then
  echo "production-readiness exited unexpectedly with ${PRODUCTION_READINESS_STATUS}" >&2
  exit "${PRODUCTION_READINESS_STATUS}"
fi

echo "== setup walkthrough =="
./scripts/super-browser setup --client cursor

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "== whitespace check =="
  git diff --check
fi

echo "super_browser_package_verification_ok"
