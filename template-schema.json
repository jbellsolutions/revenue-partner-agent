{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://orgo.ai/schemas/template/orgo.ai-v1.json","title":"Orgo Template (orgo.ai/v1)","description":"An Orgo template describes a reproducible AI-agent computer: hardware, the secrets it needs, installed apps, long-running services, files, lifecycle hooks, reactive triggers, and pre-staged terminals. Metal builds it once into a content-addressed golden snapshot; launching it creates a real VM. Authored in YAML (comments encouraged) or the equivalent JSON. A short \"sugar\" form is also accepted (e.g. `name: foo@1.0.0`, `cpu: 2`, `display: 1280x720`, `wallpaper: <url>`) and is desugared into this canonical shape server-side.","type":"object","required":["api_version","template"],"additionalProperties":false,"properties":{"api_version":{"type":"string","description":"Schema version of THIS document. Required, top-level (k8s-style). Distinct from template.version, which is the template’s own release version.","enum":["orgo.ai/v1"]},"template":{"$ref":"#/$defs/metadata","description":"Template identity and provenance."},"secrets":{"type":"array","description":"Named secrets this template needs. Values are NEVER stored in the template — the launching user supplies them from their Orgo vault, injected into the VM at create time. Reference a secret from env / files / streaming via `{secret: <name>}`.","maxItems":64,"items":{"$ref":"#/$defs/secretDecl"}},"hardware":{"$ref":"#/$defs/hardware","description":"VM resource shape."},"vars":{"type":"object","description":"Template variables, interpolated into strings as ${var.NAME} before build.","additionalProperties":{"type":"string"}},"env":{"type":"object","description":"Environment variables written to the VM. Each value is either a literal string, or a secret reference `{secret: <name>}` resolved at create from the launcher’s vault. Keys must be UPPER_SNAKE_CASE.","propertyNames":{"pattern":"^[A-Z_][A-Z0-9_]*$"},"additionalProperties":{"$ref":"#/$defs/envValue"}},"build":{"$ref":"#/$defs/build","description":"Extra build-time install steps (apt/pip/npm/run)."},"files":{"type":"array","description":"Files materialized into the VM image (build) or at boot (runtime).","maxItems":256,"items":{"$ref":"#/$defs/file"}},"apps":{"type":"array","description":"Installed applications, their long-running services, health checks, and ports.","maxItems":64,"items":{"$ref":"#/$defs/app"}},"triggers":{"type":"array","description":"Reactive handlers: a source produces events, optional dedup suppresses noise, actions run.","maxItems":256,"items":{"$ref":"#/$defs/trigger"}},"streaming":{"type":"array","description":"Outbound RTMP(S) streams of the desktop.","maxItems":16,"items":{"$ref":"#/$defs/stream"}},"terminal":{"type":"array","description":"Pre-staged tmux sessions that orgo-web’s terminal attaches to by name. Created detached at first boot. NOT auto-restarted — use apps[].services for a process that must respawn.","maxItems":32,"items":{"$ref":"#/$defs/session"}},"hooks":{"$ref":"#/$defs/hooks","description":"Lifecycle shell hooks."},"telemetry":{"$ref":"#/$defs/telemetry","description":"Observability outputs."},"egress_policy":{"$ref":"#/$defs/egressPolicy","description":"Per-VM egress allow/block rules (enforced on the host)."}},"$defs":{"metadata":{"type":"object","required":["name","version"],"additionalProperties":false,"properties":{"name":{"type":"string","description":"Template name. Lowercase kebab-case, 1–64 chars.","pattern":"^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$|^[a-z0-9]$"},"version":{"type":"string","description":"The template’s own version. Semver (e.g. 1.0.0). Immutable once published.","pattern":"^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"},"description":{"type":"string","description":"One-line human description, shown in the gallery."},"publisher":{"type":"string","description":"Publisher handle (kebab-case).","pattern":"^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$|^[a-z0-9]$"},"license":{"type":"string","description":"SPDX license id (e.g. MIT). Informational."},"homepage":{"type":"string","format":"uri","description":"Project homepage (http/https)."},"source":{"type":"string","format":"uri","description":"Source repository URL (http/https)."},"integrity":{"type":"string","description":"Optional content integrity marker."}}},"secretDecl":{"type":"object","required":["name"],"additionalProperties":false,"properties":{"name":{"type":"string","description":"Secret name. Lowercase, alphanumeric with - or _ (matches the vault entry).","pattern":"^[a-z0-9][a-z0-9_-]{0,62}[a-z0-9]$|^[a-z0-9]$"},"description":{"type":"string","description":"What the secret is, shown to the launching user."},"example":{"type":"string","description":"Example value shape (e.g. \"sk-ant-...\")."},"docs_url":{"type":"string","format":"uri","description":"Where to obtain the secret."},"optional":{"type":"boolean","description":"If true, the template still launches without it (injected only when present).","default":false}}},"hardware":{"type":"object","additionalProperties":false,"properties":{"os":{"type":"string","description":"Operating system.","enum":["linux"]},"cpu":{"type":"number","description":"vCPU count (0.5 = fractional baseline).","enum":[0.5,1,2,4,8,16]},"ram_gb":{"type":"integer","description":"RAM in GB.","enum":[4,8,16,32,64]},"disk_gb":{"type":"integer","description":"Disk in GB.","minimum":1},"gpu":{"type":"string","description":"GPU model.","enum":["none","t4","l4","a10","l40s","a100-40","a100-80","h100"]},"gpu_count":{"type":"integer","description":"Number of GPUs.","minimum":0},"bandwidth_mbps":{"type":"integer","description":"Network bandwidth cap (Mbps).","minimum":0},"resolution":{"type":"string","description":"Desktop resolution WIDTHxHEIGHTxDEPTH (e.g. 1280x720x24).","pattern":"^\\d+x\\d+x\\d+$"},"auto_stop_minutes":{"type":"integer","description":"Idle minutes before auto-stop. 0 disables. Max 1440 (24h).","minimum":0,"maximum":1440},"region":{"type":"string","description":"Placement region.","enum":["auto-us","iad","sjc","lax"]},"audio":{"type":"boolean","description":"Enable the audio device.","default":false}}},"envValue":{"description":"A literal string, or a secret reference {secret: <name>}.","oneOf":[{"type":"string","description":"Literal value."},{"type":"object","required":["secret"],"additionalProperties":false,"properties":{"secret":{"type":"string","description":"Name of a declared secret (see top-level `secrets`)."}}}]},"build":{"type":"object","additionalProperties":false,"description":"Build-time package/command steps, run once when baking the golden.","properties":{"apt":{"type":"array","items":{"type":"string"},"description":"apt-get packages."},"pip":{"type":"array","items":{"type":"string"},"description":"pip packages."},"npm":{"type":"array","items":{"type":"string"},"description":"global npm packages."},"run":{"type":"array","items":{"type":"string"},"description":"Shell commands (max 64), in order.","maxItems":64}}},"file":{"type":"object","required":["to"],"additionalProperties":false,"description":"Exactly one of `from` or `inline` must be set.","properties":{"from":{"type":"string","description":"Source URI. Scheme one of: file, git, http, https, secret, s3. (secret://<name> pulls from the vault.)"},"inline":{"type":"string","description":"Inline file content."},"to":{"type":"string","description":"Absolute destination path (or ~/...). No `..`, no reserved system paths."},"mode":{"type":"string","description":"Octal permission, e.g. \"0644\".","pattern":"^[0-7]{3,4}$"},"owner":{"type":"string","description":"Owner user."},"group":{"type":"string","description":"Owner group."},"when":{"type":"string","description":"Materialize at build or at runtime.","enum":["build","runtime"]}}},"app":{"type":"object","required":["name"],"additionalProperties":false,"properties":{"name":{"type":"string","description":"App name (kebab-case, unique).","pattern":"^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$|^[a-z0-9]$"},"title":{"type":"string","description":"Human label for dashboards."},"description":{"type":"string","description":"Shown in orgo-web app cards."},"install":{"type":"string","description":"Shell script run at build to install the app."},"requires":{"type":"array","items":{"type":"string"},"description":"Names of other apps this depends on."},"data":{"type":"array","items":{"type":"string"},"description":"Persistent data paths (validated like file.to)."},"services":{"type":"array","description":"Long-running processes managed by supervisord (auto-restart, survive reboot).","items":{"$ref":"#/$defs/service"}},"health":{"$ref":"#/$defs/health","description":"Liveness check + on-fail action (the watchdog)."},"ports":{"type":"array","items":{"$ref":"#/$defs/port"},"description":"Exposed network ports."},"autostart":{"type":"array","items":{"$ref":"#/$defs/autostart"},"description":"Desktop GUI autostart entries."}}},"service":{"type":"object","required":["name","run"],"additionalProperties":false,"description":"A supervisord program. With restart=always it respawns on crash and starts at every boot.","properties":{"name":{"type":"string","description":"Service name (kebab-case, unique across all apps).","pattern":"^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$|^[a-z0-9]$"},"title":{"type":"string","description":"Human label."},"description":{"type":"string","description":"What the service does."},"run":{"type":"string","description":"Command to run (the long-lived process)."},"cwd":{"type":"string","description":"Working directory."},"user":{"type":"string","description":"User to run as."},"env":{"type":"object","additionalProperties":{"type":"string"},"description":"Extra env vars for this service."},"restart":{"type":"string","description":"Restart policy. always = respawn always; on-failure = only on non-zero exit; no = never.","enum":["always","on-failure","no"],"default":"always"},"stop_signal":{"type":"string","description":"Signal used to stop (e.g. TERM, INT)."},"log":{"type":"string","description":"Log file path."}}},"health":{"type":"object","required":["type"],"additionalProperties":false,"description":"Polled liveness check. On `retries` consecutive failures, `on_fail` runs.","properties":{"type":{"type":"string","description":"Check kind.","enum":["http","tcp","command","process"]},"url":{"type":"string","format":"uri","description":"http: URL to GET."},"port":{"type":"integer","description":"tcp: port to connect.","minimum":1,"maximum":65535},"command":{"type":"string","description":"command: shell command that must exit 0."},"process":{"type":"string","description":"process: process name that must be running."},"every":{"type":"string","description":"Check interval (Go duration, e.g. 30s). Default 30s.","pattern":"^\\d+(ns|us|µs|ms|s|m|h)$"},"timeout":{"type":"string","description":"Per-check timeout (Go duration). Default 5s.","pattern":"^\\d+(ns|us|µs|ms|s|m|h)$"},"retries":{"type":"integer","description":"Consecutive failures before on_fail. Default 3.","minimum":1},"on_fail":{"type":"string","description":"Action on failure: \"restart_vm\", \"alert\", \"none\", or \"restart_service:<service_name>\"."}}},"port":{"type":"object","required":["internal"],"additionalProperties":false,"properties":{"internal":{"type":"integer","description":"In-VM port. 1–65535, not 5900/5999/6080/8080 (reserved).","minimum":1,"maximum":65535},"external":{"type":"integer","description":"Externally mapped port (0 = none).","minimum":0,"maximum":65535},"protocol":{"type":"string","description":"Protocol.","enum":["tcp","udp","http","ws"]},"public":{"type":"boolean","description":"Expose publicly.","default":false},"description":{"type":"string","description":"What the port serves."}}},"autostart":{"type":"object","required":["run"],"additionalProperties":false,"description":"A GUI app launched on the desktop at boot.","properties":{"run":{"type":"string","description":"Command to launch."},"delay":{"type":"integer","description":"Seconds to wait after boot before launching.","minimum":0}}},"trigger":{"type":"object","required":["name","source","actions"],"additionalProperties":false,"properties":{"name":{"type":"string","description":"Trigger name (unique)."},"title":{"type":"string","description":"Human label."},"description":{"type":"string","description":"What it reacts to."},"enabled":{"type":"boolean","description":"Defaults to true when omitted."},"source":{"$ref":"#/$defs/source","description":"The event source."},"dedup":{"$ref":"#/$defs/dedup","description":"Optional noise suppression."},"actions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/action"},"description":"Actions to run (≥1)."}}},"source":{"type":"object","required":["type"],"description":"Event source. `type` selects which fields apply: file{path,events}, log{service,match,parse}, process{process}, http{url,method,expect_code,interval}, cron{schedule}, metric{metric,op,value,duration}, event{event}, desktop{event}.","properties":{"type":{"type":"string","enum":["file","log","process","http","cron","metric","event","desktop"]},"path":{"type":"string","description":"file: absolute path to watch."},"events":{"type":"array","items":{"type":"string","enum":["create","modify","delete"]},"description":"file: which fs events."},"service":{"type":"string","description":"log: service whose logs to tail."},"match":{"type":"string","description":"log: substring/pattern to match."},"parse":{"type":"string","description":"log: line format.","enum":["text","json"]},"process":{"type":"string","description":"process: process name."},"url":{"type":"string","format":"uri","description":"http: URL to poll."},"method":{"type":"string","description":"http: method."},"expect_code":{"type":"integer","description":"http: expected status code."},"interval":{"type":"string","description":"http: poll interval (Go duration).","pattern":"^\\d+(ns|us|µs|ms|s|m|h)$"},"schedule":{"type":"string","description":"cron: 5-field cron expression."},"metric":{"type":"string","description":"metric: which metric.","enum":["cpu_percent","ram_percent","disk_percent","net_in_mbps","net_out_mbps","gpu_percent","gpu_memory_percent","gpu_temp_celsius"]},"op":{"type":"string","description":"metric: comparison.","enum":[">",">=","<","<=","==","!="]},"value":{"type":"number","description":"metric: threshold."},"duration":{"type":"string","description":"metric: sustained-for window (Go duration).","pattern":"^\\d+(ns|us|µs|ms|s|m|h)$"},"event":{"type":"string","description":"event/desktop: event name (desktop has a fixed set: window_focus, clipboard, idle, …)."}}},"dedup":{"type":"object","additionalProperties":false,"description":"At most one of debounce / cooldown / rate_limit.","properties":{"debounce":{"type":"string","description":"Collapse bursts within this window (Go duration).","pattern":"^\\d+(ns|us|µs|ms|s|m|h)$"},"cooldown":{"type":"string","description":"Minimum gap between fires (Go duration).","pattern":"^\\d+(ns|us|µs|ms|s|m|h)$"},"rate_limit":{"type":"string","description":"Cap fires, \"<count>/<duration>\" e.g. 10/1m.","pattern":"^[1-9][0-9]*/[0-9]+(s|m|h)$"}}},"action":{"type":"object","required":["type"],"description":"What runs when a trigger fires. `type` selects fields: webhook{url,method,headers,body}, command{run,cwd,timeout}, service{op,target}, notify{title,level}, log{message}, api{endpoint}.","properties":{"type":{"type":"string","enum":["webhook","command","service","notify","log","api"]},"url":{"type":"string","format":"uri","description":"webhook: URL."},"method":{"type":"string","description":"webhook: HTTP method."},"headers":{"type":"object","additionalProperties":{"type":"string"},"description":"webhook: headers."},"body":{"type":"string","description":"webhook: body ({{...}} templating allowed)."},"run":{"type":"string","description":"command: shell command."},"cwd":{"type":"string","description":"command: working directory."},"timeout":{"type":"string","description":"command: timeout (Go duration).","pattern":"^\\d+(ns|us|µs|ms|s|m|h)$"},"op":{"type":"string","description":"service: operation.","enum":["start","stop","restart"]},"target":{"type":"string","description":"service: target service name."},"title":{"type":"string","description":"notify: title."},"level":{"type":"string","description":"notify: severity.","enum":["info","warning","critical"]},"message":{"type":"string","description":"log: message."},"endpoint":{"type":"string","description":"api: internal endpoint."}}},"stream":{"type":"object","required":["name","url","key"],"additionalProperties":false,"properties":{"name":{"type":"string","description":"Stream name."},"url":{"type":"string","description":"RTMP(S) ingest URL.","pattern":"^rtmps?://"},"key":{"$ref":"#/$defs/envValue","description":"Stream key — literal or {secret: <name>}."},"autostart":{"type":"boolean","description":"Start streaming at boot.","default":false}}},"session":{"type":"object","required":["name"],"additionalProperties":false,"properties":{"name":{"type":"string","description":"tmux session name (unique). Terminals attach by this name."},"title":{"type":"string","description":"Tab label in the terminal panel."},"description":{"type":"string","description":"Tooltip text."},"cwd":{"type":"string","description":"Working directory."},"run":{"type":"string","description":"Command sent to the session as its first input."}}},"hooks":{"type":"object","additionalProperties":false,"description":"Shell run at lifecycle points. Each runs with set -e.","properties":{"on_first_boot":{"type":"string","description":"Once, on the VM’s first boot."},"on_every_boot":{"type":"string","description":"On every boot (including restores)."},"on_pre_snapshot":{"type":"string","description":"Before a golden snapshot is taken."},"on_resume":{"type":"string","description":"When resumed from a snapshot."},"on_shutdown":{"type":"string","description":"On graceful shutdown."}}},"telemetry":{"type":"object","additionalProperties":false,"properties":{"metrics":{"type":"boolean","description":"Emit VM metrics."},"logs":{"type":"array","items":{"type":"string"},"description":"Log file paths to ship."},"otel_endpoint":{"type":"string","description":"OpenTelemetry collector endpoint."}}},"egressPolicy":{"type":"object","required":["mode","rules"],"additionalProperties":false,"properties":{"mode":{"type":"string","description":"allow = only `rules` reachable; block = everything except `rules`.","enum":["allow","block"]},"rules":{"type":"array","items":{"type":"string"},"description":"Domain patterns (*.github.com), exact domains, IPs, or CIDRs (10.0.0.0/8)."}}}}}